# ===== Claude (obrigatório) =====
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# ===== Painel e página de teste (obrigatório em produção) =====
PAINEL_SENHA=troque-esta-senha

# ===== WhatsApp Cloud API (Meta) - deixe vazio para usar só a página de teste =====
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=orya-verifica
META_APP_SECRET=
WABA_ID=
GRAPH_VERSION=v23.0

# Números que recebem os avisos (agendamento, pedido de ligação, transferência), com 55 + DDD
EQUIPE_WHATSAPP=5511976122138
# Como o bot se apresenta
ATENDENTE=o atendimento da ORYA

# ===== Opcionais =====
# Templates aprovados no Meta (para mensagens fora da janela de 24h)
TEMPLATE_LEMBRETE=
TEMPLATE_AVISO_EQUIPE=
TEMPLATE_IDIOMA=pt_BR
# Dataset do Meta (API de Conversões): envia "Schedule" quando a lead do anúncio agenda
META_DATASET_ID=

# ===== Relatórios por e-mail (Gmail: crie uma "senha de app" em myaccount.google.com/apppasswords) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
RELATORIO_EMAIL=
RELATORIO_HORA=20

# ===== Follow-up de quem parou de responder =====
FOLLOWUP_ATIVO=1
FOLLOWUP_DIAS=1,3,7,15,30
FOLLOWUP_MENSAL_DIAS=30
FOLLOWUP_HORA_INICIO=9
FOLLOWUP_HORA_FIM=20
# Templates aprovados no Meta para cada etapa (fora da janela de 24h)
FOLLOWUP_TEMPLATES=1:orya_followup_d1,3:orya_followup_d3,7:orya_followup_d7,15:orya_followup_d15,30:orya_followup_d30,mensal:orya_mensal_vip
GRUPO_VIP_LINK=

AGRUPAR_SEGUNDOS=7
PAUSA_HUMANO_HORAS=12
LEMBRETES_ATIVOS=1
DATA_DIR=./data
